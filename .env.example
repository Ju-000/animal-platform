# 절대 실제 키나 비밀번호를 git에 커밋하지 마세요.
# 이 파일을 복사해서 .env 파일을 만든 뒤 값만 바꿔 사용하세요.

# Backend
FRONTEND_BASE_URL=http://localhost:5173
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/again_family?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useUnicode=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Public data portal (data.go.kr)
PUBLIC_API_KEY=your_data_go_kr_service_key
SHELTER_DEFAULT_CAPACITY=30

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-nano-9b-v2:free,openai/gpt-oss-120b:free,qwen/qwen3-14b:free
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=다시, 가족

# PortOne payments
PORTONE_STORE_ID=your_portone_store_id
PORTONE_CHANNEL_KEY=your_portone_channel_key
PORTONE_API_KEY=your_portone_rest_api_key
PORTONE_API_SECRET=your_portone_api_secret
PORTONE_API_BASE_URL=https://api.iamport.kr

# OAuth2 clients
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

# Storage
STORAGE_TYPE=local
LOCAL_UPLOAD_ROOT=uploads
LOCAL_UPLOAD_PUBLIC_PATH=/uploads
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your_s3_bucket_name
CLOUDFRONT_URL=https://cdn.example.com

# Frontend
VITE_API_BASE_URL=http://localhost:8080
