# 절대 이 파일의 실제 값을 git에 커밋하지 마세요.

# 데이터베이스 - 운영/도커에서 사용할 DB 접속 URL입니다.
DB_URL=jdbc:mysql://localhost:3306/again_family?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useUnicode=true&allowPublicKeyRetrieval=true&useSSL=false
# 데이터베이스 - DB 접속 사용자명입니다.
DB_USERNAME=your_db_user
# 데이터베이스 - DB 접속 비밀번호입니다.
DB_PASSWORD=your_db_password

# 서버 - Spring Boot 실행 프로필입니다. local 또는 prod를 사용합니다.
SPRING_PROFILES_ACTIVE=local
# 서버 - 백엔드 포트입니다.
SERVER_PORT=8080
# 프론트엔드 - CORS/메일 링크 등에 사용할 프론트 주소입니다.
FRONTEND_BASE_URL=http://localhost:5173

# 공공데이터포털 - data.go.kr 유기동물 API 서비스 키입니다.
PUBLIC_API_KEY=your_data_go_kr_service_key

# OpenRouter - AI 소개/챗봇 호출용 API 키입니다.
OPENROUTER_API_KEY=your_openrouter_api_key
# OpenRouter - 한국어 응답 안정성을 위해 고정한 무료 모델입니다.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OpenRouter - 기본 무료 모델이 제한되면 순서대로 시도할 무료 모델 목록입니다.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-nano-9b-v2:free,openai/gpt-oss-120b:free,qwen/qwen3-14b:free
# OpenRouter - 요청 출처 표시용 프론트 주소입니다.
OPENROUTER_REFERER=http://localhost:5173
# OpenRouter - OpenRouter 대시보드에 표시될 앱 이름입니다.
OPENROUTER_TITLE=포동포동

# PortOne 결제 - PortOne Store ID입니다.
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PortOne 결제 - 결제 채널 키입니다.
PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PortOne 결제 - REST API Key입니다.
PORTONE_API_KEY=your_portone_api_key
# PortOne 결제 - REST API Secret입니다.
PORTONE_API_SECRET=your_portone_api_secret

# OAuth2 - Google OAuth 클라이언트 ID입니다.
GOOGLE_CLIENT_ID=your_google_client_id
# OAuth2 - Google OAuth 클라이언트 Secret입니다.
GOOGLE_CLIENT_SECRET=your_google_client_secret
# OAuth2 - Kakao OAuth 클라이언트 ID입니다.
KAKAO_CLIENT_ID=your_kakao_client_id
# OAuth2 - Kakao OAuth 클라이언트 Secret입니다.
KAKAO_CLIENT_SECRET=your_kakao_client_secret
# OAuth2 - Naver OAuth 클라이언트 ID입니다.
NAVER_CLIENT_ID=your_naver_client_id
# OAuth2 - Naver OAuth 클라이언트 Secret입니다.
NAVER_CLIENT_SECRET=your_naver_client_secret

# 메일 - SMTP 서버 호스트입니다.
MAIL_HOST=smtp.example.com
# 메일 - SMTP 서버 포트입니다.
MAIL_PORT=587
# 메일 - SMTP 로그인 사용자명입니다.
MAIL_USERNAME=your_mail_username
# 메일 - SMTP 로그인 비밀번호입니다.
MAIL_PASSWORD=your_mail_password
# 메일 - SMTP 인증 사용 여부입니다.
MAIL_SMTP_AUTH=true
# 메일 - SMTP STARTTLS 사용 여부입니다.
MAIL_SMTP_STARTTLS_ENABLE=true

# 스토리지 - local 또는 s3를 선택합니다.
STORAGE_TYPE=local
# 로컬 스토리지 - 로컬 업로드 저장 경로입니다.
LOCAL_UPLOAD_ROOT=uploads
# 로컬 스토리지 - 브라우저에 노출할 업로드 URL prefix입니다.
LOCAL_UPLOAD_PUBLIC_PATH=/uploads

# AWS S3 (운영 이미지 업로드) - AWS Access Key ID입니다.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS S3 (운영 이미지 업로드) - AWS Secret Access Key입니다.
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS S3 (운영 이미지 업로드) - S3 리전입니다.
AWS_REGION=ap-northeast-2
# AWS S3 (운영 이미지 업로드) - 업로드 버킷명입니다.
S3_BUCKET_NAME=your_s3_bucket_name
# AWS S3 (운영 이미지 업로드) - CloudFront 도메인이 있으면 입력합니다.
CLOUDFRONT_URL=https://cdn.example.com
